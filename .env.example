# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Optional: HTTP/SOCKS proxy for Telegram API requests (e.g. if blocked)
# TELEGRAM_PROXY=http://127.0.0.1:10809

# Optional: Path to local model directory or Hugging Face model repository ID
# Default fallback: Qwen/Qwen2.5-0.5B-Instruct
# Recommended for production: Qwen/Qwen2.5-1.5B-Instruct
# MODEL_PATH=Qwen/Qwen2.5-1.5B-Instruct
